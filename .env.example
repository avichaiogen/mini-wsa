# Local development (without Docker)
DB_URL=jdbc:postgresql://localhost:5432/miniwsa
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password

# Docker: no .env file needed — docker-compose.yml sets defaults automatically.
# To override, either create a .env file with the variables above, or export them:
#   DB_NAME=mydb DB_USERNAME=myuser DB_PASSWORD=mypass docker compose up --build
